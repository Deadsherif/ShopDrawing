<Window x:Class="ShopDrawing.Presentation.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:ShopDrawing.Presentation.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="clr-namespace:ShopDrawing.Presentation.Views"
    Width="550"
    Height="550"
    Padding="5"
    Background="#FFE6E6E6"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Window.Resources>
        <ResourceDictionary>
            <converters:CountToBoolConverter x:Key="CountToBoolConverter"/>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDefault.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>

    </Window.Resources>
    <DockPanel>
        <TabControl SelectedIndex="{Binding SelectedTabIndex}">
            <TabItem Header="Dashboard">
                <!--<views:DashboardView DataContext="{Binding DashboardVM}"/>-->
            </TabItem>
            <TabItem Header="Batch Processing">
                <views:BatchProcessingView DataContext="{Binding BatchProcessingVM}"/>
            </TabItem>
        </TabControl>
    </DockPanel>

</Window>
